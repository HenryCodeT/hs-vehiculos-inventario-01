generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id            String    @id @default(cuid())
  fechaFactura  DateTime?
  vin           String    @default("")
  marca         String    @default("")
  modelo        String    @default("")
  color         String    @default("")
  cliente       String    @default("")
  precioCompra  Float?
  precioVenta   Float?
  fechaLlegada  DateTime?
  ubicacion     String    @default("")
  codigo        String    @default("")
  asesor        String    @default("")
  estado        String    @default("LIBRE")
  situacion     String    @default("PENDIENTE")
  observaciones String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("vehicles")
}
